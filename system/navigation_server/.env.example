# MQTT Broker (IP of PC1)
MQTT_BROKER_HOST=192.168.1.100
MQTT_BROKER_PORT=1883

# Camera
CAMERA_DEVICE=/dev/video0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_SKIP_DEVICES=

# ArUco markers
REFERENCE_MARKER_IDS=1,2,3,4
MOBILE_MARKER_IDS=0

# Map
MAP_WIDTH=100
MAP_HEIGHT=100
# Obstacles as JSON array (or empty for no obstacles)
MAP_OBSTACLES=[]

# Position publish rate
PUBLISH_RATE_HZ=15
