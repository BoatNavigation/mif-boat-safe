# MQTT Broker (PC1 -- localhost if broker is on the same machine)
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883

# Flask web server
FLASK_HOST=0.0.0.0
FLASK_PORT=8080

# Vehicle IDs to monitor (comma-separated)
# Must match VEHICLE_ID values set on each physical vehicle
# Single vehicle:  VEHICLE_IDS=vehicle_0
# Two vehicles:    VEHICLE_IDS=vehicle_0,vehicle_5
# Three vehicles:  VEHICLE_IDS=vehicle_0,vehicle_5,vehicle_6
VEHICLE_IDS=vehicle_0
